# LLM connection (the user supplies credentials for the provider or endpoint).
SWITCHTUNE_LLM_SOURCE=Custom
SWITCHTUNE_LLM_MODEL=your-model-id
SWITCHTUNE_LLM_BASE_URL=https://your-provider.example/v1
SWITCHTUNE_LLM_API_KEY=replace_with_your_llm_api_key

# Portable SwitchTune paths
SWITCHTUNE_HOME=/path/to/SwitchTune
SWITCHTUNE_RUNS=/path/to/SwitchTune_runs
SWITCHTUNE_CONFIG=/path/to/SwitchTune/config/switchtune.yaml
SWITCHTUNE_TOOL_REGISTRY=/path/to/SwitchTune/config/tool_registry.yaml
SWITCHTUNE_DECISION_POLICY=/path/to/SwitchTune/config/decision_policy.yaml

# Local model installations (edit to match the host)
LIGANDMPNN_REPO=/path/to/LigandMPNN
ESM_IF1_REPO=/path/to/esm
ESM_IF1_SCORE_SCRIPT=/path/to/esm/examples/inverse_folding/score_log_likelihoods.py
BIOEMU_HOME=/path/to/bioemu
BOLTZ_CACHE=/path/to/boltz2_cache
ROSETTA_HOME=/path/to/rosetta/main

# Optional hosted structure backend; local Boltz-2 is the default.
BOLTZ2_API_KEY=replace_with_your_structure_backend_key
