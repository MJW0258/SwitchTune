# API credentials and local environment settings.
# LLM connection (the user supplies credentials for the provider or endpoint).
SWITCHTUNE_LLM_SOURCE=Custom
SWITCHTUNE_LLM_MODEL=your-model-id
SWITCHTUNE_LLM_BASE_URL=https://your-provider.example/v1
SWITCHTUNE_LLM_API_KEY=replace_with_your_llm_api_key

# Required per run: either inline text or a UTF-8 file with the design request.
SWITCHTUNE_PROMPT="Describe the desired state-specific mutation design here."
# SWITCHTUNE_PROMPT_FILE=/path/to/design_request.md

# Portable SwitchTune paths
SWITCHTUNE_HOME=/path/to/SwitchTune
SWITCHTUNE_RUNS=/path/to/SwitchTune_runs
SWITCHTUNE_CONFIG=/path/to/SwitchTune/config/switchtune.yaml
SWITCHTUNE_TOOL_REGISTRY=/path/to/SwitchTune/config/tool_registry.yaml
SWITCHTUNE_DECISION_POLICY=/path/to/SwitchTune/config/decision_policy.yaml

# Local model installations (edit to match the host)
LIGANDMPNN_REPO=/path/to/LigandMPNN
ESM_IF1_REPO=/path/to/esm
ESM_IF1_SCORE_SCRIPT=/path/to/esm/examples/inverse_folding/score_log_likelihoods.py
BIOEMU_HOME=/path/to/bioemu
BOLTZ_CACHE=/path/to/boltz2_cache
# Absolute executable if Boltz-2 is installed in a separate conda environment.
# BOLTZ_LOCAL_EXECUTABLE=/path/to/envs/boltz2/bin/boltz
ROSETTA_HOME=/path/to/rosetta/main

# Choose once before model installation:
# python3 scripts/configure_structure_backend.py
# Saved to ignored config/structure_backend.local.json and read automatically.
# Optional per-run override (otherwise omit this variable):
# SWITCHTUNE_STRUCTURE_ENGINE=alphafold3
# Advanced AF3 overrides; normally configure them with the selection helper.
# AF3_DEPLOYMENT=docker
# AF3_DOCKER_IMAGE=alphafold3
# AF3_MODEL_DIR=/data/af3/models
# AF3_DB_DIR=/data/af3/databases
# AF3_REPO=/path/to/alphafold3
# AF3_PYTHON=/path/to/af3/bin/python
# AF3_MSA_MODE=search
# AF3_INPUT_TEMPLATE=/data/prepared_wt_af3.json
# AF3_NUM_SAMPLES=5
# AF3_SEEDS=1

# Optional hosted structure backend; local Boltz-2 is the default.
BOLTZ2_API_KEY=replace_with_your_structure_backend_key
